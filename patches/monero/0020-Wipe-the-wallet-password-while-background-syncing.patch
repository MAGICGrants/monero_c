From da987ba43975116e864018c7e39a0981adbd1803 Mon Sep 17 00:00:00 2001
From: MAGIC Grants <info@magicgrants.org>
Date: Mon, 19 Oct 2026 15:21:11 -0500
Subject: [PATCH] Wipe the wallet password while background syncing

start_background_sync() wipes the spend key from memory, but WalletImpl
kept its own copy of the wallet password in m_password for as long as
the wallet stayed open. That password decrypts the keys file, and so
the spend key, which defeats the point of background sync.

Wipe m_password when background sync starts, and take it back from
stopBackgroundSync(), which checks it against the keys file. Also:
- overwrite the password before letting it go in ~WalletImpl() and in
  setPassword(), since std::string does not clear what it frees;
- refuse store() to a new path while background syncing: writing new
  files needs the password;
- refuse secretSpendKey() and getPolyseed() while background syncing,
  as seed() already does, instead of answering a key, or a seed, of
  zeros.

Upstream, the open https://github.com/monero-project/monero/pull/10232
removes the cached password from the Wallet API altogether: callers pass
it where it is needed, and it is never kept. This is the narrower change
for background sync on the release branch; it will be removed when that
PR is merged.
---
 src/wallet/api/wallet.cpp | 29 +++++++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/src/wallet/api/wallet.cpp b/src/wallet/api/wallet.cpp
index 4b0d56660..57c967c0b 100644
--- a/src/wallet/api/wallet.cpp
+++ b/src/wallet/api/wallet.cpp
@@ -38,6 +38,7 @@
 #include "subaddress_account.h"
 #include "common_defines.h"
 #include "common/util.h"
+#include "memwipe.h"
 
 #include "mnemonics/electrum-words.h"
 #include "mnemonics/english.h"
@@ -96,6 +97,15 @@ using namespace cryptonote;
 namespace Monero {
 
 namespace {
+    // Overwrites a secret before the string lets go of it: std::string never
+    // clears the memory it frees.
+    void wipe(std::string &s)
+    {
+        if (!s.empty())
+            memwipe(&s[0], s.size());
+        s.clear();
+    }
+
     // copy-pasted from simplewallet
     static const int    DEFAULT_REFRESH_INTERVAL_MILLIS = 1000 * 10;
     // limit maximum refresh interval as one minute
@@ -496,6 +506,7 @@ WalletImpl::~WalletImpl()
     close(false); // do not store wallet as part of the closing activities
     // Stop refresh thread
     stopRefresh();
+    wipe(m_password);
 
     if (m_wallet2Callback->getListener()) {
       m_wallet2Callback->getListener()->onSetWallet(nullptr);
@@ -887,6 +898,10 @@ bool WalletImpl::getPolyseed(std::string &seed_words, std::string &passphrase) c
     return false;
   }
 
+  // Background sync has wiped the seed: wallet2 would encode one of zeros.
+  if (checkBackgroundSync("cannot get polyseed"))
+    return false;
+
   bool result = m_wallet->get_polyseed(seed_words_epee, passphrase_epee);
 
   seed_words.assign(seed_words_epee.data(), seed_words_epee.size());
@@ -962,6 +977,7 @@ bool WalletImpl::setPassword(const std::string &password)
     clearStatus();
     try {
         m_wallet->change_password(m_wallet->get_wallet_file(), m_password, password);
+        wipe(m_password);
         m_password = password;
     } catch (const std::exception &e) {
         setStatusError(e.what());
@@ -1022,6 +1038,9 @@ std::string WalletImpl::publicViewKey() const
 
 std::string WalletImpl::secretSpendKey() const
 {
+    // Background sync has wiped the key: wallet2 would answer zeros.
+    if (checkBackgroundSync("cannot get secret spend key"))
+        return "";
     return epee::string_tools::pod_to_hex(unwrap(unwrap(m_wallet->get_account().get_keys().m_spend_secret_key)));
 }
 
@@ -1058,6 +1077,11 @@ bool WalletImpl::store(const std::string &path)
         if (path.empty()) {
             m_wallet->store();
         } else {
+            // New files need the password, which background sync has let go of.
+            if (m_wallet->is_background_syncing()) {
+                setStatusError(tr("Cannot store to a new path while background syncing"));
+                return false;
+            }
             m_wallet->store_to(path, m_password);
         }
     } catch (const std::exception &e) {
@@ -1523,6 +1547,9 @@ bool WalletImpl::startBackgroundSync()
         PRE_VALIDATE_BACKGROUND_SYNC();
         LOCK_REFRESH();
         m_wallet->start_background_sync();
+        // The password opens the keys file, and so the spend key wallet2 has
+        // just wiped: it goes too, until stopBackgroundSync is given it again.
+        wipe(m_password);
     }
     catch (const std::exception &e)
     {
@@ -1540,6 +1567,8 @@ bool WalletImpl::stopBackgroundSync(const std::string &wallet_password)
         PRE_VALIDATE_BACKGROUND_SYNC();
         LOCK_REFRESH();
         m_wallet->stop_background_sync(epee::wipeable_string(wallet_password));
+        // Checked against the keys file by stop_background_sync.
+        m_password = wallet_password;
     }
     catch (const std::exception &e)
     {
-- 
